        // ========== Language Mapping ==========
        // Maps browser language codes to supported language codes
        const languageMap = {
            // Arabic
            'ar': 'ar-SA', 'ar-SA': 'ar-SA', 'ar-EG': 'ar-SA', 'ar-AE': 'ar-SA',
            // Bulgarian
            'bg': 'bg-BG', 'bg-BG': 'bg-BG',
            // Catalan
            'ca': 'ca-ES', 'ca-ES': 'ca-ES',
